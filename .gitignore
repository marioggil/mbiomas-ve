# Local Pi runtime state
.atl/
# Impeccable, the design skill for coding agents, installed into the project by
# `npx impeccable install --providers=pi --scope=project`. It is 23 MB, most of
# it a static linux-x64 engine binary, and one command reinstalls it, so it does
# not belong in the history.
.pi/

# Rasters are never versioned: raw, normalized and tiled all live outside Git.
# 40 annual GeoTIFFs = 2.9 GB raw; COG outputs add ~3.8 GB.
data/raw/
data/cog/
data/tiles/
*.tif
*.tiff
*.aux.xml
*.mbtiles
*.pmtiles
*.ovr

# Python and Node local state
.venv/
__pycache__/
*.pyc
node_modules/
viewer/dist/

# Local tool output: Playwright screenshots and snapshots from viewer verification
data/**/*.log
.playwright-mcp/

# CodeGraph index: a coding agent's local index of this workspace. Rebuilt on
# demand and different for every reader, so it is never versioned.
.codegraph/
